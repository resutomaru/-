{
  "name": "Push deals to Telegram",
  "nodes": [
    {
      "parameters": {},
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [-80, 96],
      "id": "11111111-1111-1111-1111-111111111101",
      "name": "Manual test run"
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      },
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [-80, -64],
      "id": "11111111-1111-1111-1111-111111111102",
      "name": "Every 5 min"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "select client_id, chat_id, lot_id, title, url, price, median_price, sample_size, скидка_проц, condition, region, city, trust, score from public.push_queue;",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [144, 0],
      "id": "11111111-1111-1111-1111-111111111103",
      "name": "Read push_queue",
      "credentials": {
        "postgres": {
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Карточка находки (план §6.7): модель+цена, % ниже медианы, балл, светофор, состояние, ссылка.\n// Светофор RR-06: красное НЕ прячем — помечаем предупреждением.\nconst light = { green: '🟢', yellow: '🟡', red: '🔴' };\nreturn $input.all().map(({ json: d }) => {\n  const warn = d.trust === 'red' ? '\\n⚠️ ОСТОРОЖНО: признаки риска (слишком глубокая скидка / мало фото / пустое описание) — проверь лично!' : '';\n  const cond = d.condition === 'working' ? 'рабочее' : 'состояние не указано';\n  const text =\n    `${light[d.trust] || ''} ${Number(d.score).toFixed(1)}/10 — ${d.title}\\n` +\n    `💰 ${Number(d.price).toLocaleString('ru-RU')} ₽ (−${d['скидка_проц']}% от медианы ${Number(d.median_price).toLocaleString('ru-RU')} ₽, выборка ${d.sample_size})\\n` +\n    `${cond} | ${d.city || d.region || ''}` + warn + `\\n${d.url}`;\n  return { json: { ...d, text } };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [352, 0],
      "id": "11111111-1111-1111-1111-111111111104",
      "name": "Format card"
    },
    {
      "parameters": {
        "chatId": "={{ $json.chat_id }}",
        "text": "={{ $json.text }}",
        "additionalFields": {
          "disable_web_page_preview": false
        }
      },
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [560, 0],
      "id": "11111111-1111-1111-1111-111111111105",
      "name": "Send to Telegram"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "insert into sent_log (client_id, lot_id, score) values ($1, $2, $3) on conflict (client_id, lot_id) do nothing;",
        "options": {
          "queryReplacement": "={{ $('Format card').item.json.client_id }},{{ $('Format card').item.json.lot_id }},{{ $('Format card').item.json.score }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [768, 0],
      "id": "11111111-1111-1111-1111-111111111106",
      "name": "Mark sent (dedup)",
      "credentials": {
        "postgres": {
          "name": "Postgres account"
        }
      }
    }
  ],
  "pinData": {},
  "connections": {
    "Manual test run": {
      "main": [[{ "node": "Read push_queue", "type": "main", "index": 0 }]]
    },
    "Every 5 min": {
      "main": [[{ "node": "Read push_queue", "type": "main", "index": 0 }]]
    },
    "Read push_queue": {
      "main": [[{ "node": "Format card", "type": "main", "index": 0 }]]
    },
    "Format card": {
      "main": [[{ "node": "Send to Telegram", "type": "main", "index": 0 }]]
    },
    "Send to Telegram": {
      "main": [[{ "node": "Mark sent (dedup)", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  }
}
